# ---- Copy to .env and fill in only what you actually use. Never commit .env ----

# Core
DEV_MODE=0                  # 1 enables /api/dev/* helpers (shift review dates for demos)
STORE_CODE=1                # 0 = do not store submitted code in the database
STORE_FIRST_STEPS=1         # 0 = do not store first-step sentences (used to build a real labelled dataset)
MAX_CONCURRENT_RUNS=2       # cap on simultaneous code executions
FINDER_DEADLINE_S=20        # max seconds the finder may spend on one submission (stops a slow program hogging a worker)
MAX_SUBMITS_PER_DAY=80      # per learner id
REVIEW_INTERVALS_DAYS=1,3,7,21

# Open-model tutor (leave LLM_PROVIDER=none to use the deterministic fallbacks)
LLM_PROVIDER=none           # none | ollama | openai
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b     # check `ollama list` for the exact tag you pulled
LLM_BASE_URL=               # OpenAI-compatible endpoint, e.g. DigitalOcean Serverless Inference
LLM_API_KEY=
LLM_MODEL=

# Later milestones (not used by the baseline code yet)
SENTRY_DSN=
BACKBOARD_API_KEY=
TINKER_API_KEY=
TEMPORAL_ADDRESS=

# Optional: any hosted payment link (PayPal.me, Stripe Payment Link, Razorpay link, Ko-fi...). https only.
PAYMENT_URL=
PAYMENT_LABEL=Get my full learning report

# Paid "full learning report" unlock. Use either or both:
PRO_CODES=                  # hand-issued codes, comma separated, long and random (8+ chars)
GUMROAD_PRODUCT_ID=         # Gumroad issues one license key per sale; the app verifies it, no manual step